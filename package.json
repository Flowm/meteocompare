{
  "name": "meteocompare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "pnpm lint:web && pnpm lint:worker",
    "lint:fix": "pnpm lint:fix:web && pnpm lint:fix:worker",
    "deploy": "pnpm build && pnpm --filter meteocompare-worker deploy",
    "deploy:preview": "pnpm build && pnpm --filter meteocompare-worker deploy:preview",
    "dev:worker": "pnpm --filter meteocompare-worker dev",
    "lint:web": "oxlint --disable-nested-config && oxfmt --disable-nested-config --check && vue-tsc",
    "lint:worker": "pnpm --filter meteocompare-worker lint",
    "lint:fix:web": "oxlint --disable-nested-config --fix && oxfmt --disable-nested-config --write",
    "lint:fix:worker": "pnpm --filter meteocompare-worker lint:fix",
    "test:worker": "pnpm --filter meteocompare-worker test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vueuse/core": "^14.4.0",
    "echarts": "^6.1.0",
    "posthog-js": "^1.430.2",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.3.1",
    "weather-icons": "^1.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.9.0"
}
